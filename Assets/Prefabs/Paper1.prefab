  m_Script: {fileID: 11500000, guid: 2f87f825262272d45ae75a5833b78681, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableInteractables
  text: "- Don\u2019t forget to take your pills at 10:00!\r\n- Don\u2019t forget
    to hydrate once every hour!\r\n- See you next week. Love you grandpa! - Sarah\r\n-
    Did you already take your meal from the freezer? It needs to defrost.\r\n- Bring
    back books to the library before the 24th this month (\u201CJohn and His Men\u201D
    and \u201CBrewing Techniques\u201D)\r\n- Trash should be out on Thursdays!\r\n-
    Angela will visit and do your laundry every Saturday.\r\n- Check-up appointment
    with neurologist on the 28th this month at 9:15. Angela will come get you at
    8:30.\r\n- Angela will bring you to the hospital the 25th at 11:20 for your epidural
    injection."
  heading: 
  rereadable: 1
